OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB 本地路径（自动创建，无需额外服务）
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=stock_filings

RAG_TOP_K=5

# LangSmith（可选）— https://smith.langchain.com 注册免费账号后填入
# 启用后可在 LangSmith 平台查看完整的 Agent 执行轨迹（含 Reflection Loop）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your-langsmith-key-here
LANGCHAIN_PROJECT=stock-advisor
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

CORS_ORIGINS=http://localhost:3000

# Redis（LangGraph Checkpointer — 留空则以无持久化模式运行）
REDIS_URL=redis://localhost:6379

# PostgreSQL（历史报告存储 — 留空则使用内存缓存）
DATABASE_URL=postgresql://stockadvisor:stockadvisor@localhost:5432/stockadvisor
